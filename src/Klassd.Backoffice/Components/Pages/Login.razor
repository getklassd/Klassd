@page "/admin/login"
@layout EmptyLayout
@inject CmsOptions Options

<div class="login-wrap">
    <div class="login-card">
        <h1>Klass<span>d</span></h1>
        @if (Error)
        {
            <div class="login-error">@ErrorMessage</div>
        }
        @if (Options.LocalLoginEnabled)
        {
            <form method="post" action="/admin/auth/login">
                <div class="form-group">
                    <label>Username</label>
                    <input name="username" autocomplete="username" placeholder="admin" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" autocomplete="current-password" placeholder="••••••••" />
                </div>
                <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;">Sign in</button>
            </form>
        }

        @if (Options.ExternalLoginsView.Count > 0)
        {
            @if (Options.LocalLoginEnabled)
            {
                <div class="login-divider"><span>or</span></div>
            }
            @foreach (var provider in Options.ExternalLoginsView)
            {
                <a class="btn btn-ghost login-sso" href="/admin/auth/external/@Uri.EscapeDataString(provider.Scheme)">
                    Sign in with @provider.DisplayName
                </a>
            }
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorParam { get; set; }
    private bool Error => !string.IsNullOrEmpty(ErrorParam);
    private string ErrorMessage => ErrorParam switch
    {
        "sso" => "Single sign-on failed or your account is not allowed.",
        _ => "Invalid username or password",
    };
}

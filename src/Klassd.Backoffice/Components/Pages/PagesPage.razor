@page "/admin"
@page "/admin/pages"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject PageTreeState Tree
@inject EditorPanelState Editor
@inject LocaleState Locale

<div class="area-layout">
    <aside class="context-tree">
        <div class="context-tree-header">
            <h2>Pages</h2>
            @if (Locale.IsPrimary)
            {
                <button class="btn btn-primary btn-sm" @onclick="() => Editor.OpenForCreate()">+ New</button>
            }
        </div>
        <div class="context-tree-body">
            <PageTree />
        </div>
    </aside>

    <section class="area-detail">
        @if (Editor.PanelOpen)
        {
            <EditorPanel />
        }
        else
        {
            <div class="empty-state pages-empty">Select a page, or create one.</div>
        }
    </section>
</div>

@code {
    private bool _loaded;
    [SupplyParameterFromQuery(Name = "edit")] public string? EditId { get; set; }

    protected override void OnInitialized()
    {
        Tree.Changed += OnChanged;
        Editor.Changed += OnChanged;
        Locale.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_loaded)
        {
            _loaded = true;
            await Locale.EnsureLoadedAsync();
            await Tree.LoadAsync();
            if (!string.IsNullOrEmpty(EditId) && Tree.Pages.FirstOrDefault(p => p.Id == EditId) is { } target)
                await Editor.OpenForEditAsync(target);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Tree.Changed -= OnChanged;
        Editor.Changed -= OnChanged;
        Locale.Changed -= OnChanged;
    }
}

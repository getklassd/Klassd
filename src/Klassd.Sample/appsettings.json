{
  "MongoDB": {
    "ConnectionString": "mongodb://root:example@localhost:27017",
    "DatabaseName": "klassd"
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Username=postgres;Password=example;Database=klassd"
  },
  "Sqlite": {
    "ConnectionString": "Data Source=klassd.db"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Klassd": {
    "AllowSchedulePreview": false,
    "Auth": {
      "SigningKey": "klassd-sample-dev-signing-key-0123456789abcdef"
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Delivery": {
      "RequireApiKey": false,
      "ApiKey": "",
      "ApiKeyHeader": "X-Api-Key"
    },
    "Telemetry": {
      "_comment": "Disabled in this dev sample so local runs don't phone home. Real installs default to enabled + https://telemetry.getklassd.com (opt-out).",
      "Enabled": false
    }
  },
  "CmsLocalization": {
    "Locales": [
      { "Code": "en",    "Label": "English", "Mandatory": true, "TimeZone": "Europe/London" },
      { "Code": "en-dk", "Label": "English / Denmark", "FallbackTo": "en", "TimeZone": "Europe/Copenhagen" },
      { "Code": "da-dk", "Label": "Dansk / Danmark", "TimeZone": "Europe/Copenhagen" },
      { "Code": "ar-ae", "Label": "Arabic / UAE", "TimeZone": "Asia/Dubai" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Klassd.Data.MongoDb</PackageId>
    <Description>MongoDB storage adapter for Klassd (single database).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Attaches the matching Klassd.Auth MongoDB store to the same database. -->
    <PackageReference Include="Klassd.Auth.Abstractions" />
    <PackageReference Include="Klassd.Auth.Data.MongoDb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klassd.Abstractions\Klassd.Abstractions.csproj" />
  </ItemGroup>

</Project>

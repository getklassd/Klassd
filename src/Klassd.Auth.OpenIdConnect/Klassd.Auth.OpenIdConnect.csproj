<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Klassd.Auth.OpenIdConnect</PackageId>
    <Description>OpenID Connect / OAuth 2.0 single sign-on for the Klassd backoffice (SSO).</Description>
  </PropertyGroup>

  <!-- AuthenticationBuilder + cookie types come from the shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine supplies the external-login seam (AddExternalLogin / CmsAuthSchemes). -->
    <ProjectReference Include="..\Klassd.Backoffice\Klassd.Backoffice.csproj" />
  </ItemGroup>

</Project>

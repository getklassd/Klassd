  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klassd.Abstractions\Klassd.Abstractions.csproj" />
  </ItemGroup>

</Project>

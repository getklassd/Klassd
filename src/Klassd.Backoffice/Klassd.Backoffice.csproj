<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Klassd.Backoffice</PackageId>
    <Description>Reusable CMS backoffice engine (Blazor Interactive Server admin + headless API) packaged as a Razor Class Library. Install into an ASP.NET Core host alongside a storage adapter to get a full code-first CMS.</Description>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    NOTE: a consuming host whose only Blazor components come from this RCL (no .razor of its own)
    must set <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets> in its OWN csproj, or it 404s
    on _framework/blazor.web.js. This can't be shipped from here: that property gates a restore-time
    framework PackageDownload, and NuGet restore does not import a package's build/buildTransitive
    props (chicken-and-egg), so a value we'd set would arrive too late. Document it for hosts instead.
  -->

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klassd.Core\Klassd.Core.csproj" />
    <ProjectReference Include="..\Klassd.Abstractions\Klassd.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Authentication / users: the engine wires Klassd.Auth (cookie scheme + user/roles services)
         internally so the host's AddKlassd/UseKlassd surface stays unchanged. -->
    <PackageReference Include="Klassd.Auth.Abstractions" />
    <PackageReference Include="Klassd.Auth.Core" />
    <PackageReference Include="Klassd.Auth.AspNetCore.Cookies" />
  </ItemGroup>

</Project>

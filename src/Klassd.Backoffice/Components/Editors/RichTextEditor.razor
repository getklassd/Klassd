@inherits PropertyEditorBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Rich text editor backed by Quill (vendored, loaded globally in App.razor). The host div is an
   empty Blazor leaf; Quill builds its toolbar + editor inside it via richtext.js, so Blazor
   re-renders (from ValueChanged) never clobber the DOM or jump the caret. Quill provides the
   toolbar, so there's no markup here beyond the host. *@
<div class="klassd-rte" @ref="_host"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RichTextEditor>? _ref;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/_content/Klassd.Backoffice/richtext.js");
        _ref = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attach", _host, _ref, Value ?? string.Empty);
    }

    [JSInvokable]
    public Task OnHtmlChanged(string html) => SetValueAsync(html);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detach", _host);
                await _module.DisposeAsync();
            }
        }
        catch { /* circuit already gone */ }
        _ref?.Dispose();
    }
}

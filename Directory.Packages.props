<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Single source of truth for package versions across the solution (pinned). -->
  <ItemGroup>
    <!-- Extensions / framework abstractions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />

    <!-- Storage adapters -->
    <PackageVersion Include="MongoDB.Driver" Version="3.9.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.8" />

    <!-- Cache adapters -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.0.0" />

    <!-- Search -->
    <PackageVersion Include="Lucene.Net" Version="4.8.0-beta00017" />
    <PackageVersion Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
    <PackageVersion Include="Lucene.Net.QueryParser" Version="4.8.0-beta00017" />

    <!-- GraphQL (opt-in delivery package) -->
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.1.3" />

    <!-- Media blob adapters -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.23.5" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="4.14.0" />

    <!-- Authentication / users: the external Klassd.Auth suite. The OIDC package pulls
         Microsoft.AspNetCore.Authentication.OpenIdConnect transitively, so the CMS no longer
         pins it directly. -->
    <PackageVersion Include="Klassd.Auth.Abstractions" Version="0.0.1-beta.1" />
    <PackageVersion Include="Klassd.Auth.Core" Version="0.0.1-beta.1" />
    <PackageVersion Include="Klassd.Auth.AspNetCore.Cookies" Version="0.0.1-beta.1" />
    <PackageVersion Include="Klassd.Auth.OpenIdConnect" Version="0.0.1-beta.1" />
    <PackageVersion Include="Klassd.Auth.Data.Sqlite" Version="0.0.1-beta.1" />
    <PackageVersion Include="Klassd.Auth.Data.Postgres" Version="0.0.1-beta.1" />
    <PackageVersion Include="Klassd.Auth.Data.MongoDb" Version="0.0.1-beta.1" />

    <!-- Testing -->
    <PackageVersion Include="TUnit" Version="1.47.0" />
    <PackageVersion Include="TUnit.Playwright" Version="1.47.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.12.0" />
  </ItemGroup>

</Project>

@page "/admin/dictionary"
@attribute [Authorize]
@rendermode InteractiveServer
@using Klassd.Backoffice.Modules.Dictionary.Services
@using Klassd.Core.Localization
@inject DictionaryService Dict
@inject LocaleRegistry Locales
@inject ToastService Toasts

<div class="area-layout">
    <aside class="context-tree">
        <div class="context-tree-header">
            <h2>Dictionary</h2>
            <button class="btn btn-primary btn-sm" @onclick="() => _adding = !_adding">@(_adding ? "Cancel" : "+ New")</button>
        </div>
        <div class="context-tree-body">
            @if (_rows is null)
            {
                <p class="no-blocks">Loading…</p>
            }
            else if (_rows.Count == 0)
            {
                <p class="no-blocks">No keys yet.</p>
            }
            else
            {
                <ul class="context-list">
                    @foreach (var row in _rows)
                    {
                        <li>
                            <button class="@(!_adding && row.Key == _selected?.Key ? "context-active" : "")" @onclick="() => Select(row)">
                                <TypeIcon Name="tag" />
                                <span class="user-name">@row.Key</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>

    <section class="area-detail">
        @if (_adding)
        {
            <div class="editor-inline">
                <div class="panel-header">
                    <h2>New key</h2>
                    <button class="panel-close" title="Close" @onclick="() => _adding = false">✕</button>
                </div>
                <div class="panel-body">
                    <div class="edit-col">
                        <div class="form-group">
                            <label>Key</label>
                            <input type="text" @bind="_newKey" placeholder="common.no" />
                        </div>
                        @foreach (var l in _localeCodes)
                        {
                            <div class="form-group">
                                <label class="locale-label">@l.ToLowerInvariant() @if (l == _defaultCode) { <span class="badge badge-ghost">default</span> }</label>
                                <input type="text" value="@_newValues[l]" @oninput="e => _newValues[l] = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        }
                        <p class="slug-preview">
                            Named translations the frontend fetches per locale (e.g. common.no → No / Nej / Nein).
                            Missing values fall back through the locale chain. Headless: GET /api/dictionary/resolved/{locale}.
                        </p>
                    </div>
                </div>
                <div class="panel-footer">
                    <button class="btn btn-ghost" @onclick="() => _adding = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="AddAsync">Create key</button>
                </div>
            </div>
        }
        else if (_selected is null)
        {
            <div class="pages-empty">Select a key, or create one.</div>
        }
        else
        {
            <div class="editor-inline">
                <div class="panel-header">
                    <h2>@_selected.Key</h2>
                    <div class="panel-header-right">
                        <button class="btn-icon" title="Delete key" @onclick="() => DeleteAsync(_selected.Key)">✕</button>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="edit-col">
                        @foreach (var l in _localeCodes)
                        {
                            <div class="form-group">
                                <label class="locale-label">@l.ToLowerInvariant() @if (l == _defaultCode) { <span class="badge badge-ghost">default</span> }</label>
                                <input type="text" value="@_selected.Values[l]"
                                       @oninput="e => _selected.Values[l] = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        }
                    </div>
                </div>
                <div class="panel-footer">
                    <button class="btn btn-primary" @onclick="() => SaveAsync(_selected)">Save</button>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private sealed class Row { public string Key = ""; public Dictionary<string, string> Values = new(); }

    private List<Row>? _rows;
    private Row? _selected;
    private string[] _localeCodes = [];
    private string? _defaultCode;

    private bool _adding;
    private string _newKey = "";
    private Dictionary<string, string> _newValues = new();

    protected override void OnInitialized()
    {
        _localeCodes = Locales.All.Select(l => l.Code).ToArray();
        _defaultCode = Locales.All.FirstOrDefault(l => l.IsDefault)?.Code ?? _localeCodes.FirstOrDefault();
        _newValues = _localeCodes.ToDictionary(c => c, _ => "");
    }

    private void Select(Row row) => _selected = row;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReloadAsync();
            StateHasChanged();
        }
    }

    private async Task ReloadAsync()
    {
        var entries = await Dict.GetAllAsync();
        _rows = entries
            .OrderBy(e => e.Key, StringComparer.OrdinalIgnoreCase)
            .Select(e => new Row
            {
                Key = e.Key,
                Values = _localeCodes.ToDictionary(c => c, c => e.Values.GetValueOrDefault(c, "")),
            })
            .ToList();

        // Re-point the selection at the freshly-loaded row instance (or clear it if gone).
        _selected = _selected is null ? null : _rows.FirstOrDefault(r => r.Key == _selected.Key);
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newKey))
        {
            Toasts.Error("Key is required.");
            return;
        }
        if (_rows?.Any(r => string.Equals(r.Key, _newKey.Trim(), StringComparison.OrdinalIgnoreCase)) == true)
        {
            Toasts.Error($"Key '{_newKey.Trim()}' already exists.");
            return;
        }
        try
        {
            var createdKey = _newKey.Trim();
            await Dict.UpsertAsync(_newKey, _newValues);
            _newKey = "";
            _newValues = _localeCodes.ToDictionary(c => c, _ => "");
            _adding = false;
            await ReloadAsync();
            _selected = _rows?.FirstOrDefault(r => r.Key == createdKey);
            Toasts.Success("Key created.");
        }
        catch (InvalidOperationException ex) { Toasts.Error(ex.Message); }
    }

    private async Task SaveAsync(Row row)
    {
        await Dict.UpsertAsync(row.Key, row.Values);
        Toasts.Success($"'{row.Key}' saved.");
    }

    private async Task DeleteAsync(string key)
    {
        await Dict.DeleteAsync(key);
        await ReloadAsync();
        Toasts.Success($"'{key}' deleted.");
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Klassd</title>
    <base href="/" />
    @* Apply the saved (or OS-preferred) theme before first paint to avoid a flash. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('klassd-theme');
                if (t !== 'light' && t !== 'dark') {
                    t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <link rel="stylesheet" href="_content/Klassd.Backoffice/daisyui.css" />
    <link rel="stylesheet" href="_content/Klassd.Backoffice/klassd.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

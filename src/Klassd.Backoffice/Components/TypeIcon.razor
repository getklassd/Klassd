@*
    Renders a page-type icon. Name is either a key from the built-in line-icon set below
    (e.g. "house", "folder", "image") or any literal glyph/emoji ("🏠"), which is shown as-is.
    Null/empty falls back to the generic "file" icon. Icons are stroked with currentColor so
    they inherit the surrounding text colour (muted in the tree, coral when the node is active).
*@
@{
    var key = Name?.Trim();
}
@if (string.IsNullOrEmpty(key))
{
    @RenderSvg(Icons["file"])
}
else if (Icons.TryGetValue(key.ToLowerInvariant(), out var paths))
{
    @RenderSvg(paths)
}
else
{
    <span class="type-icon type-icon-glyph" aria-hidden="true">@key</span>
}

@code {
    [Parameter] public string? Name { get; set; }

    private RenderFragment RenderSvg(string inner) => builder =>
    {
        builder.AddMarkupContent(0,
            $"<svg class=\"type-icon\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" " +
            $"stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" " +
            $"aria-hidden=\"true\">{inner}</svg>");
    };


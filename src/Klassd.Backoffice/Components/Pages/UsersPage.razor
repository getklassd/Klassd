@page "/admin/users"
@attribute [Authorize]
@rendermode InteractiveServer
@using Klassd.Auth.Abstractions
@using Klassd.Auth.Core.Modules.Users
@using Klassd.Backoffice.Modules.Auth
@using Klassd.Backoffice.Modules.Preferences.Services
@using Klassd.Backoffice.State
@inject UserAccountService Accounts
@inject RolesService Roles
@inject PreferencesService Preferences
@inject AdminUser CurrentUser
@inject ToastService Toasts

@if (!_canManageUsers)
{
    <div class="pages-empty">You don't have permission to manage users.</div>
}
else
{
<div class="area-layout">
    <aside class="context-tree">
        <div class="context-tree-header">
            <h2>Users</h2>
            <button class="btn btn-primary btn-sm" @onclick="() => _creating = !_creating">@(_creating ? "Cancel" : "+ New")</button>
        </div>
        <div class="context-tree-body">
            @if (_users is null)
            {
                <p class="no-blocks">Loading…</p>
            }
            else
            {
                <ul class="context-list">
                    @foreach (var u in _users)
                    {
                        <li>
                            <button class="@(!_creating && u.Id == _selected?.Id ? "context-active" : "")" @onclick="() => Select(u)">
                                <span class="user-avatar">@DisplayName(u)[..1].ToUpperInvariant()</span>
                                <span class="user-name @(u.Disabled ? "is-disabled" : "")">@DisplayName(u)</span>
                                @if (Provider(u) != "local")
                                {
                                    <span class="badge badge-info" style="margin-left:auto;">@Provider(u)</span>
                                }
                                @if (u.Disabled)
                                {
                                    <span class="badge badge-ghost" style="margin-left:6px;">disabled</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>

    <section class="area-detail">
        @if (_creating)
        {
            <div class="editor-inline">
                <div class="panel-header">
                    <h2>New user</h2>
                    <button class="panel-close" title="Close" @onclick="() => _creating = false">✕</button>
                </div>
                <div class="panel-body">
                    <div class="edit-col">
                        <div class="form-group"><label>Username</label><input type="text" @bind="_newUsername" placeholder="jane" /></div>
                        <div class="form-group"><label>Password</label><input type="password" @bind="_newPassword" placeholder="••••••••" /></div>
                        <div class="form-group">
                            <label>Roles</label>
                            @foreach (var role in CmsRoles.All)
                            {
                                <label class="role-check"><input type="checkbox" checked="@_newRoles.Contains(role)"
                                    @onchange="e => ToggleRole(_newRoles, role, (bool)e.Value!)" /> @role</label>
                            }
                        </div>
                        <p class="slug-preview">For SSO (SAML/OAuth) users, no password is needed — they're provisioned automatically on first sign-in. No roles = full administrator.</p>
                    </div>
                </div>
                <div class="panel-footer">
                    <button class="btn btn-ghost" @onclick="() => _creating = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateAsync">Create user</button>
                </div>
            </div>
        }
        else if (_selected is null)
        {
            <div class="pages-empty">Select a user, or create one.</div>
        }
        else
        {
            <div class="editor-inline">
                <div class="panel-header">
                    <h2>@DisplayName(_selected)</h2>
                    <div class="panel-header-right">
                        @if (_selected.Id == _currentUserId)
                        {
                            <span class="badge badge-success">you</span>
                        }
                        else
                        {
                            <button class="btn btn-ghost btn-sm" @onclick="ToggleDisabledAsync">
                                @(_selected.Disabled ? "Enable" : "Disable")
                            </button>
                        }
                    </div>
                </div>
                <div class="panel-body">
                    <div class="edit-col">
                        <div class="form-group"><label>User Id</label><div class="compare-value">@_selected.Id</div></div>
                        <div class="form-group"><label>Username</label><div class="compare-value">@(string.IsNullOrEmpty(_selected.Username) ? "—" : _selected.Username)</div></div>
                        <div class="form-group"><label>Email</label><div class="compare-value">@(string.IsNullOrEmpty(_selected.PrimaryEmail) ? "—" : _selected.PrimaryEmail)</div></div>
                        <div class="form-group"><label>Login provider</label><div class="compare-value">@Provider(_selected)</div></div>
                        <div class="form-group"><label>Status</label><div class="compare-value">@(_selected.Disabled ? "Disabled" : "Active")</div></div>

                        <div class="divider"></div>

                        <div class="section-label">Roles</div>
                        @foreach (var role in CmsRoles.All)
                        {
                            <label class="role-check"><input type="checkbox" checked="@_editRoles.Contains(role)"
                                @onchange="e => ToggleRole(_editRoles, role, (bool)e.Value!)" /> @role</label>
                        }
                        <div style="margin-top:8px;"><button class="btn btn-ghost" @onclick="SaveRolesAsync">Save roles</button></div>
                        <p class="slug-preview" style="margin-top:6px;">Effective permissions are the union across roles. No roles = full administrator.</p>

                        <div class="divider"></div>

                        <div class="section-label">Reset password</div>
                        <div style="display:flex;gap:10px;align-items:flex-end;">
                            <div class="form-group" style="margin-bottom:0;flex:1;max-width:280px;">
                                <input type="password" @bind="_resetPassword" placeholder="New password" />
                            </div>
                            <button class="btn btn-ghost" @onclick="ResetPasswordAsync">Set password</button>
                        </div>

                        <div class="divider"></div>

                        <div class="section-label">Preferences</div>
                        <button class="btn btn-ghost" @onclick="ResetPreferencesAsync">Reset preferences</button>
                        <p class="slug-preview" style="margin-top:6px;">Clears this user's saved locale, collapsed tree nodes and theme back to defaults.</p>
                    </div>
                </div>
            </div>
        }
    </section>
</div>
}

@code {
    private IReadOnlyList<User>? _users;
    private User? _selected;
    private string? _currentUserId;

    private bool _creating;
    private string _newUsername = "";
    private string _newPassword = "";
    private string _resetPassword = "";
    private bool _canManageUsers = true;
    private readonly HashSet<string> _newRoles = new(StringComparer.OrdinalIgnoreCase) { CmsRoles.Editor };
    private readonly HashSet<string> _editRoles = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canManageUsers = await CurrentUser.HasCapabilityAsync(Capabilities.UsersManage);
            _currentUserId = await CurrentUser.GetUserIdAsync();
            if (_canManageUsers) await ReloadAsync();
            StateHasChanged();
        }
    }

    private async Task ReloadAsync() => _users = await Accounts.GetAllAsync();

    // Display name + provider derive from the new Klassd.Auth User model (no Provider/Roles members).
    private static string DisplayName(User u) =>
        !string.IsNullOrEmpty(u.Username) ? u.Username
        : !string.IsNullOrEmpty(u.PrimaryEmail) ? u.PrimaryEmail!
        : u.Id;

    private static string Provider(User u) =>
        u.LoginMethods.FirstOrDefault(m => m.Kind == LoginMethodKind.ThirdParty)?.ProviderId ?? "local";

    private async Task Select(User user)
    {
        _selected = user;
        _resetPassword = "";
        _editRoles.Clear();
        foreach (var r in await Roles.GetRolesAsync(user.Id)) _editRoles.Add(r);
    }

    private static void ToggleRole(HashSet<string> set, string role, bool on)
    {
        if (on) set.Add(role); else set.Remove(role);
    }

    private async Task SaveRolesAsync()
    {
        if (_selected is null) return;
        await Roles.SetRolesAsync(_selected.Id, _editRoles.ToList());
        await ReloadAsync();
        _selected = _users?.FirstOrDefault(u => u.Id == _selected.Id);
        Toasts.Success("Roles updated.");
    }

    private async Task ResetPreferencesAsync()
    {
        if (_selected is null) return;
        await Preferences.ResetAsync(_selected.Id);
        Toasts.Success($"Preferences for '{DisplayName(_selected)}' reset to defaults.");
    }

    private async Task CreateAsync()
    {
        try
        {
            var created = await Accounts.CreateLocalAsync(_newUsername, null, _newPassword);
            await Roles.SetRolesAsync(created.Id, _newRoles.ToList());
            _newUsername = _newPassword = "";
            _creating = false;
            await ReloadAsync();
            await Select(created);
            Toasts.Success($"User '{DisplayName(created)}' created.");
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task ToggleDisabledAsync()
    {
        if (_selected is null || _selected.Id == _currentUserId) return;
        await Accounts.SetDisabledAsync(_selected.Id, !_selected.Disabled);
        await ReloadAsync();
        _selected = _users?.FirstOrDefault(u => u.Id == _selected.Id);
        Toasts.Success(_selected?.Disabled == true ? "User disabled." : "User enabled.");
    }

    private async Task ResetPasswordAsync()
    {
        if (_selected is null) return;
        if (string.IsNullOrEmpty(_resetPassword))
        {
            Toasts.Error("Enter a new password first.");
            return;
        }
        await Accounts.ResetPasswordAsync(_selected.Id, _resetPassword);
        _resetPassword = "";
        Toasts.Success("Password updated.");
    }
}

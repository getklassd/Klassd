@implements IDisposable
@inject PageTreeState Tree
@inject EditorPanelState Editor
@inject LocaleState Locale
@inject ContentTypeCatalog Catalog

@if (Locale.IsPrimary)
{
    var nodes = Tree.FlatTree();
    @if (nodes.Count == 0)
    {
        <div class="empty-state">No pages yet.</div>
    }
    else
    {
        <ul class="tree-list">
            @foreach (var node in nodes)
            {
                var p = node.Page;
                <li class="tree-node @(Editor.EditingId == p.Id ? "active" : "")" style="padding-left:@(8 + node.Depth * 18)px">
                    @if (node.HasChildren)
                    {
                        <button class="tree-toggle" @onclick:stopPropagation="true" @onclick="() => Tree.ToggleCollapseAsync(p.Id)">
                            @(Tree.IsCollapsed(p.Id) ? "▶" : "▼")
                        </button>
                    }
                    else
                    {
                        <span class="tree-toggle"></span>
                    }
                    <button class="tree-label" title="@Tree.GetFullSlug(p)" @onclick="() => Editor.OpenForEditAsync(p)">
                        <TypeIcon Name="@Catalog.PageTypeIcon(p.PageTypeName)" />
                        <span class="tree-title">@p.Name</span>
                        @if (Tree.HasDraft(p.Id))
                        {
                            <span class="tree-draft-dot" title="Unpublished draft"></span>
                        }
                    </button>
                    <span class="tree-actions">
                        @if (Catalog.CanHaveChildren(p.PageTypeName))
                        {
                            <button class="btn-icon edit" title="Add child" @onclick:stopPropagation="true"
                                    @onclick="() => Editor.OpenForCreate(p.Id, null, Catalog.AllowedChildren(p.PageTypeName))">＋</button>
                        }
                        <button class="btn-icon" title="Delete" @onclick:stopPropagation="true" @onclick="() => Editor.DeleteAsync(p.Id)">✕</button>
                    </span>
                </li>
            }
        </ul>
    }
}
else
{
    var nodes = Tree.FlatPrimaryTree();
    @if (nodes.Count == 0)
    {
        <div class="empty-state">No pages to translate yet.</div>
    }
    else
    {
        <ul class="tree-list">
            @foreach (var node in nodes)
            {
                var p = node.Page;
                var translated = Tree.HasTranslation(p.ContentId);
                var t = translated ? Tree.Translation(p.ContentId) : null;
                <li class="tree-node @(t != null && Editor.EditingId == t.Id ? "active" : "")" style="padding-left:@(8 + node.Depth * 18)px">
                    <span class="tree-toggle"></span>
                    @if (translated)
                    {
                        <button class="tree-label" @onclick="() => Editor.OpenForEditAsync(t!)">
                            <TypeIcon Name="@Catalog.PageTypeIcon(p.PageTypeName)" />
                            <span class="tree-title">@p.Name</span>
                            <span class="badge badge-success tree-type">Translated</span>
                        </button>
                        <span class="tree-actions">
                            <button class="btn-icon" title="Delete" @onclick:stopPropagation="true" @onclick="() => Editor.DeleteAsync(t!.Id)">✕</button>
                        </span>
                    }
                    else
                    {
                        <button class="tree-label" @onclick="() => Editor.OpenForTranslate(p)">
                            <TypeIcon Name="@Catalog.PageTypeIcon(p.PageTypeName)" />
                            <span class="tree-title">@p.Name</span>
                            <span class="badge badge-ghost tree-type">Not translated</span>
                        </button>
                    }
                </li>
            }
        </ul>
    }
}

@code {
    protected override void OnInitialized()
    {
        Tree.Changed += OnChanged;
        Editor.Changed += OnChanged;
        Locale.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Tree.Changed -= OnChanged;
        Editor.Changed -= OnChanged;
        Locale.Changed -= OnChanged;
    }
}

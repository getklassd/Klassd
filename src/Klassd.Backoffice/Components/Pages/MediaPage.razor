@page "/admin/media"
@page "/admin/media/{Section}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Klassd.Abstractions.Media
@using Klassd.Backoffice.State
@inject MediaService MediaService
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IJSRuntime JS

@if (MediaService.Sections.Count == 0)
{
    <div class="card">
        <div class="card-header"><h1>Media</h1></div>
        <div class="card-body">
            <div class="empty-state">
                <p><strong>No media sections configured.</strong></p>
                <p style="margin-top:8px;">Add one in your host startup, e.g.<br />
                    <code>builder.Services.AddMedia(m =&gt; m.AddSection("images", s =&gt; s.UseXxx(...)));</code>
                </p>
            </div>
        </div>
    </div>
}
else
{
    <div class="area-layout">
    <aside class="context-tree">
        <div class="context-tree-header"><h2>Media</h2></div>
        <div class="context-tree-body">
            <ul class="context-list">
                @foreach (var s in MediaService.Sections)
                {
                    <li>
                        <NavLink href="@($"admin/media/{s.Name}")" class="@(s.Name == _section ? "context-active" : "")">🖼 @s.Name</NavLink>
                    </li>
                }
            </ul>
        </div>
    </aside>
    <section class="area-detail">
    <div class="card">
        <div class="card-header">
            <div style="display:flex;align-items:center;gap:12px;">
                <h1>@(_section ?? "Media")</h1>
                <span class="badge badge-ghost">@VisibleItems.Count() item(s)</span>
            </div>
            <div class="panel-header-right">
                <button class="btn btn-primary" @onclick="UploadAsync" disabled="@_uploading">
                    @(_uploading ? _progressLabel ?? "Uploading…" : "Upload")
                </button>
                <button class="btn btn-secondary" @onclick="UploadManyAsync" disabled="@_uploading">Upload many</button>
            </div>
        </div>
        <div class="card-body media-dropzone" @ref="_dropZone" data-section="@_section" data-max-edge="@CurrentMaxEdge">
            @if (_items is null)
            {
                <p class="no-blocks">Loading…</p>
            }
            else if (_items.Count == 0)
            {
                <div class="empty-state">No media in this section yet.<br />Drag &amp; drop images here, or use Upload.</div>
            }
            else
            {
                <div class="media-listbar">
                    <div class="media-folders">
                        <button class="media-folder @(_selectedFolder is null ? "active" : "")"
                                @onclick="() => _selectedFolder = null">All</button>
                        @if (Folders.Count > 0)
                        {
                            <button class="media-folder @(_selectedFolder == "" ? "active" : "")"
                                    @onclick='() => _selectedFolder = ""'>Unfiled</button>
                            @foreach (var f in Folders)
                            {
                                <button class="media-folder @(_selectedFolder == f ? "active" : "")"
                                        @onclick="() => _selectedFolder = f">📁 @f</button>
                            }
                        }
                    </div>
                    <input type="search" class="input input-sm media-search" placeholder="Filter…"
                           @bind="_search" @bind:event="oninput" aria-label="Filter media in this section" />
                    <div class="join media-view-switch" role="group" aria-label="View">
                        <button class="btn btn-sm join-item @(_view == MediaView.Cards ? "btn-active" : "")"
                                @onclick="() => _view = MediaView.Cards" title="Cards">Cards</button>
                        <button class="btn btn-sm join-item @(_view == MediaView.Compact ? "btn-active" : "")"
                                @onclick="() => _view = MediaView.Compact" title="Compact grid">Compact</button>
                        <button class="btn btn-sm join-item @(_view == MediaView.List ? "btn-active" : "")"
                                @onclick="() => _view = MediaView.List" title="List">List</button>
                    </div>
                </div>

                @if (_view == MediaView.List)
                {
                    <div class="media-list">
                        @foreach (var m in VisibleItems)
                        {
                            <div class="media-row">
                                <div class="media-row-thumb">
                                    @if (m.ContentType.StartsWith("image/"))
                                    {
                                        <img src="@MediaService.UrlFor(m.Id)" alt="@(m.AltText ?? DisplayLabel(m))" />
                                    }
                                    else
                                    {
                                        <div class="media-row-file">@m.ContentType</div>
                                    }
                                </div>
                                <div class="media-row-name" title="@m.FileName">
                                    @DisplayLabel(m)
                                    @if (FolderOf(m) is { } fld) { <span class="media-row-folder">📁 @fld</span> }
                                </div>
                                <div class="media-row-sub">@Humanize(m.Size)</div>
                                <div class="media-row-actions">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => EditOpen(m)">Edit</button>
                                    <button class="btn btn-error btn-sm" @onclick="() => DeleteAsync(m)">Delete</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="media-grid @(_view == MediaView.Compact ? "media-grid-compact" : "")">
                        @foreach (var m in VisibleItems)
                        {
                            <div class="media-tile">
                                <div class="media-tile-thumb">
                                    @if (m.ContentType.StartsWith("image/"))
                                    {
                                        <img src="@MediaService.UrlFor(m.Id)" alt="@(m.AltText ?? DisplayLabel(m))" />
                                    }
                                    else
                                    {
                                        <div class="media-tile-file">@m.ContentType</div>
                                    }
                                </div>
                                <div class="media-tile-name" title="@m.FileName">@DisplayLabel(m)</div>
                                <div class="media-tile-sub">
                                    @Humanize(m.Size)
                                    @if (FolderOf(m) is { } fld) { <span>· 📁 @fld</span> }
                                </div>
                                <div class="media-tile-actions">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => EditOpen(m)">Edit</button>
                                    <button class="btn btn-error btn-sm" @onclick="() => DeleteAsync(m)">Delete</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
    </section>
    </div>

    @if (_edit is not null)
    {
        <div class="media-edit-overlay" @onclick="CloseEdit">
            <div class="media-edit-dialog" @onclick:stopPropagation="true">
                <div class="media-edit-header">
                    <h1>Edit: @DisplayLabel(_edit)</h1>
                    <button class="panel-close" title="Close" @onclick="CloseEdit">✕</button>
                </div>

                <div class="media-edit-body">
                    <div class="media-edit-cols">
                        <div class="media-edit-col">
                            <div class="form-group">
                                <label>Display name</label>
                                <input type="text" @bind="_displayName" placeholder="@_edit.FileName" />
                                <p class="slug-preview" style="margin-top:4px;">Shown in the library. Leave empty to use the file name (@_edit.FileName). The stored file is not renamed.</p>
                            </div>

                            <div class="form-group">
                                <label>Folder</label>
                                <input type="text" list="media-folder-options" @bind="_folder" placeholder="(unfiled)" />
                                <datalist id="media-folder-options">
                                    @foreach (var f in Folders)
                                    {
                                        <option value="@f" />
                                    }
                                </datalist>
                                <p class="slug-preview" style="margin-top:4px;">Visual only — does not change the file's storage path.</p>
                            </div>

                            <div class="form-group">
                                <label>Alt text</label>
                                <input type="text" @bind="_altText" placeholder="Describe the image" />
                            </div>

                            <div class="divider"></div>

                            <div class="section-label">Focal points</div>
                            <p class="slug-preview" style="margin-bottom:10px;">One per breakpoint, centered by default. Click a breakpoint, then click the image to set its focal point.</p>
                            @foreach (var (fp, i) in _focalPoints.Select((f, i) => (f, i)))
                            {
                                <div class="block-item focal-item @(i == _selectedFocal ? "active" : "")"
                                     @onclick="() => _selectedFocal = i">
                                    <div class="block-item-header">
                                        <strong>@fp.Breakpoint</strong>
                                        <span class="focal-row-right">
                                            <span class="slug-preview" style="margin:0;">X: @fp.X.ToString("0.00") &nbsp; Y: @fp.Y.ToString("0.00")</span>
                                            <button class="btn-icon edit" title="Reset to centre"
                                                    @onclick="() => ResetFocal(i)" @onclick:stopPropagation="true">↺</button>
                                        </span>
                                    </div>
                                </div>
                            }

                            <div class="divider"></div>

                            <div class="blocks-header">
                                <div class="section-label" style="margin-bottom:0;">Custom data</div>
                                <button class="btn btn-ghost btn-sm" @onclick="AddDataRow">+ Add field</button>
                            </div>
                            @if (_data.Count == 0)
                            {
                                <p class="no-blocks">No custom data.</p>
                            }
                            else
                            {
                                @foreach (var (row, i) in _data.Select((r, i) => (r, i)))
                                {
                                    <div style="display:flex;gap:8px;margin-bottom:8px;">
                                        <input type="text" placeholder="key" value="@row.Key"
                                               @oninput="e => row.Key = e.Value?.ToString() ?? string.Empty" />
                                        <input type="text" placeholder="value" value="@row.Value"
                                               @oninput="e => row.Value = e.Value?.ToString() ?? string.Empty" />
                                        <button class="btn-icon" title="Remove" @onclick="() => _data.RemoveAt(i)">✕</button>
                                    </div>
                                }
                            }
                        </div>

                        @if (_edit.ContentType.StartsWith("image/"))
                        {
                            <div class="media-edit-col">
                                <div class="section-label">Preview @(SelectedFocal is not null ? "— click to set focal point" : "")</div>
                                <div class="media-focal-wrap">
                                    <img @ref="_imgRef" class="media-focal-img" src="@MediaService.UrlFor(_edit.Id)"
                                         alt="@_altText" @onclick="OnImageClick" />
                                    @if (SelectedFocal is { } sel)
                                    {
                                        <span class="media-focal-dot" style="left:@(Pct(sel.X));top:@(Pct(sel.Y));"></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="media-edit-footer">
                    <button class="btn btn-ghost" @onclick="CloseEdit">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string? Section { get; set; }

    private enum MediaView { Cards, Compact, List }
    private MediaView _view = MediaView.Cards;

    private string? _section;                 // the section currently loaded into _items
    private IReadOnlyList<MediaRecord>? _items;
    private string? _selectedFolder;          // null = All, "" = Unfiled, else a folder name
    private string _search = "";
    private bool _uploading;
    private string? _progressLabel;

    private IJSObjectReference? _module;
    private DotNetObjectReference<MediaPage>? _selfRef;
    private ElementReference _dropZone;
    private bool _dropZoneWired;

    private MediaRecord? _edit;
    private string? _displayName;
    private string? _folder;
    private string? _altText;
    private List<MediaFocalPoint> _focalPoints = [];
    private List<DataRow> _data = [];
    private int _selectedFocal = -1;
    private ElementReference _imgRef;

    private MediaFocalPoint? SelectedFocal =>
        _selectedFocal >= 0 && _selectedFocal < _focalPoints.Count ? _focalPoints[_selectedFocal] : null;

    private record FractionDto(double X, double Y);
    private sealed class DataRow { public string Key = ""; public string Value = ""; }
    public sealed record UploadError(string FileName, string Message);
    public sealed record BulkResult(List<MediaRecord> Records, List<UploadError> Errors, bool Cancelled);

    // ── Section routing ──────────────────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        if (MediaService.Sections.Count == 0) { _section = null; _items = null; return; }

        // No section in the route -> go to the first one. Unknown section -> fall back to the first.
        var resolved = MediaService.Sections.Any(s => s.Name == Section) ? Section : MediaService.Sections[0].Name;
        if (string.IsNullOrEmpty(Section) || resolved != Section)
        {
            Nav.NavigateTo($"admin/media/{resolved}", replace: true);
            return;
        }

        if (resolved != _section)   // OnParametersSetAsync also fires for unrelated re-renders
        {
            _section = resolved;
            _edit = null;
            _selectedFolder = null;
            await ReloadAsync();
        }
    }

    // ── Folders (visual only; stored in MediaRecord.Data[FolderKey]) ──────────
    private static string? FolderOf(MediaRecord m) =>
        m.Data.TryGetValue(MediaRecord.FolderKey, out var f) && !string.IsNullOrWhiteSpace(f) ? f : null;

    private IReadOnlyList<string> Folders =>
        _items?.Select(FolderOf).Where(f => f is not null).Select(f => f!)
               .Distinct(StringComparer.OrdinalIgnoreCase)
               .OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList() ?? [];

    private IEnumerable<MediaRecord> VisibleItems
    {
        get
        {
            if (_items is null) return [];
            IEnumerable<MediaRecord> items = _selectedFolder switch
            {
                null => _items,
                "" => _items.Where(m => FolderOf(m) is null),
                var f => _items.Where(m => string.Equals(FolderOf(m), f, StringComparison.OrdinalIgnoreCase)),
            };
            var q = _search.Trim();
            if (q.Length == 0) return items;
            return items.Where(m => Has(m.FileName, q) || Has(m.DisplayName, q) || Has(m.AltText, q));

            static bool Has(string? v, string q) =>
                !string.IsNullOrEmpty(v) && v.Contains(q, StringComparison.OrdinalIgnoreCase);
        }
    }

    private static string DisplayLabel(MediaRecord m) =>
        string.IsNullOrWhiteSpace(m.DisplayName) ? m.FileName : m.DisplayName!;

    private async Task<IJSObjectReference> ModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/_content/Klassd.Backoffice/media.js");

    private async Task ReloadAsync()
    {
        if (_section is null) { _items = null; return; }
        _items = await MediaService.ListAsync(_section);
    }

    // ── Upload ───────────────────────────────────────────────────────────────
    private async Task UploadAsync()
    {
        if (_section is null || _uploading) return;
        var sec = MediaService.Sections.First(s => s.Name == _section);
        _uploading = true;
        try
        {
            var module = await ModuleAsync();
            var rec = await module.InvokeAsync<MediaRecord?>("upload", _section, sec.MaxImageEdge ?? 0);
            if (rec is not null) await ReloadAsync();
        }
        finally { _uploading = false; }
    }

    private async Task UploadManyAsync()
    {
        if (_section is null || _uploading) return;
        var sec = MediaService.Sections.First(s => s.Name == _section);
        _uploading = true;
        _progressLabel = "Uploading…";
        _selfRef ??= DotNetObjectReference.Create(this);
        try
        {
            var module = await ModuleAsync();
            var result = await module.InvokeAsync<BulkResult>("uploadMany", _section, sec.MaxImageEdge ?? 0, _selfRef);
            await ApplyBulkResultAsync(result);
        }
        catch (Exception) { Toasts.Error("Bulk upload failed."); }
        finally { _uploading = false; _progressLabel = null; }
    }

    // Reloads and reports the outcome of a bulk upload (shared by the "Upload many" button and drag-and-drop).
    private async Task ApplyBulkResultAsync(BulkResult result)
    {
        if (result.Cancelled) return;
        if (result.Records.Count > 0)
        {
            await ReloadAsync();
            Toasts.Success($"Uploaded {result.Records.Count} file(s).");
        }
        if (result.Errors.Count > 0)
        {
            var names = string.Join(", ", result.Errors.Take(5).Select(e => e.FileName));
            Toasts.Error($"{result.Errors.Count} file(s) failed: {names}{(result.Errors.Count > 5 ? "…" : "")}");
        }
        else if (result.Records.Count == 0)
        {
            Toasts.Error("No files uploaded.");
        }
    }

    [JSInvokable]
    public Task OnProgress(int done, int total, string? fileName)
    {
        _progressLabel = $"Uploading {Math.Min(done + 1, total)}/{total}…";
        return InvokeAsync(StateHasChanged);
    }

    private async Task DeleteAsync(MediaRecord m)
    {
        await MediaService.DeleteAsync(m.Id);
        if (_edit?.Id == m.Id) _edit = null;
        await ReloadAsync();
    }

    // ── Edit modal ─────────────────────────────────────────────────────────--
    private void EditOpen(MediaRecord m)
    {
        _edit = m;
        _displayName = m.DisplayName;
        _folder = FolderOf(m);
        _altText = m.AltText;

        // One focal point per configured breakpoint: reuse saved position else centre (0.5, 0.5).
        // Focal points for breakpoints no longer configured are kept at the end so they aren't lost.
        var saved = m.FocalPoints.ToDictionary(f => f.Breakpoint, f => f);
        _focalPoints = CurrentBreakpoints
            .Select(bp => saved.TryGetValue(bp, out var f)
                ? new MediaFocalPoint { Breakpoint = bp, X = f.X, Y = f.Y }
                : new MediaFocalPoint { Breakpoint = bp, X = 0.5, Y = 0.5 })
            .Concat(m.FocalPoints
                .Where(f => !CurrentBreakpoints.Contains(f.Breakpoint))
                .Select(f => new MediaFocalPoint { Breakpoint = f.Breakpoint, X = f.X, Y = f.Y }))
            .ToList();

        // The reserved folder key is edited via the Folder field, not the free-form data editor.
        _data = m.Data.Where(kv => kv.Key != MediaRecord.FolderKey)
                      .Select(kv => new DataRow { Key = kv.Key, Value = kv.Value }).ToList();
        _selectedFocal = _focalPoints.Count > 0 ? 0 : -1;
    }

    private void CloseEdit() => _edit = null;

    private IReadOnlyList<string> CurrentBreakpoints =>
        MediaService.Sections.FirstOrDefault(s => s.Name == _section)?.EffectiveBreakpoints ?? ["default"];

    private int CurrentMaxEdge =>
        MediaService.Sections.FirstOrDefault(s => s.Name == _section)?.MaxImageEdge ?? 0;

    // Wire native drag-and-drop file upload onto the card body once it exists. The drop handler reads
    // the live data-section / data-max-edge attributes, so it keeps working as the section changes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dropZoneWired || _section is null) return;
        _dropZoneWired = true;
        _selfRef ??= DotNetObjectReference.Create(this);
        await (await ModuleAsync()).InvokeVoidAsync("enableDropZone", _dropZone, _selfRef);
    }

    [JSInvokable]
    public Task OnUploadStarted()
    {
        _uploading = true;
        _progressLabel = "Uploading…";
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnBulkUploaded(BulkResult result)
    {
        try { await ApplyBulkResultAsync(result); }
        finally { _uploading = false; _progressLabel = null; await InvokeAsync(StateHasChanged); }
    }

    private void AddDataRow() => _data.Add(new DataRow());

    private void ResetFocal(int i)
    {
        if (i < 0 || i >= _focalPoints.Count) return;
        _focalPoints[i].X = 0.5;
        _focalPoints[i].Y = 0.5;
    }

    private async Task OnImageClick(MouseEventArgs e)
    {
        if (SelectedFocal is not { } fp) return;
        var module = await ModuleAsync();
        var f = await module.InvokeAsync<FractionDto>("clickFraction", _imgRef, e.ClientX, e.ClientY);
        fp.X = f.X;
        fp.Y = f.Y;
    }

    private async Task SaveAsync()
    {
        if (_edit is null) return;
        var data = _data.Where(r => !string.IsNullOrWhiteSpace(r.Key)).ToDictionary(r => r.Key, r => r.Value);
        if (!string.IsNullOrWhiteSpace(_folder)) data[MediaRecord.FolderKey] = _folder.Trim();
        await MediaService.UpdateMetadataAsync(_edit.Id, _displayName, _altText, _focalPoints, data);
        _edit = null;
        await ReloadAsync();
    }

    // InvariantCulture is required: this goes into a CSS `left`/`top` value, and a comma decimal
    // separator (e.g. da-DK "45,67%") is invalid CSS, so the dot would lose its position.
    private static string Pct(double v) => (v * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string Humanize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        int u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                if (_dropZoneWired) await _module.InvokeVoidAsync("disableDropZone", _dropZone);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}

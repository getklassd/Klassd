<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Klassd.Data.Postgres</PackageId>
    <Description>PostgreSQL storage adapter for Klassd. Raw Npgsql + jsonb (no EF/ORM), single-database.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Attaches the matching Klassd.Auth PostgreSQL store to the same database. -->
    <PackageReference Include="Klassd.Auth.Abstractions" />
    <PackageReference Include="Klassd.Auth.Data.Postgres" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klassd.Abstractions\Klassd.Abstractions.csproj" />
  </ItemGroup>

</Project>
